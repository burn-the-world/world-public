{
  "name": "world-bsc-dapp-burn-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node scripts/build-workers.mjs",
    "build:workers": "node node_modules/typescript/bin/tsc --noEmit && node scripts/build-workers.mjs",
    "workers:check": "node node_modules/wrangler/bin/wrangler.js deploy --dry-run --outdir .wrangler/dry-run",
    "workers:dev": "node node_modules/wrangler/bin/wrangler.js dev --local",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node node_modules/vitest/vitest.mjs run tests/domain.test.ts tests/chain.test.ts tests/map.test.ts tests/components.test.tsx tests/leaderboard.test.tsx tests/leaderboardCache.test.ts tests/leaderboardIndex.test.ts tests/i18n.test.tsx tests/profileNameWrite.test.ts tests/whitepaper.test.tsx",
    "test:integration": "node node_modules/vitest/vitest.mjs run tests/integration.test.ts",
    "validate:protocol": "node scripts/compile.mjs",
    "validate:release": "node ../scripts/verify-release.mjs",
    "build:contracts:release": "node ../scripts/verify-release.mjs --write",
    "chain:local": "node --import tsx scripts/local.ts",
    "chain:seed": "node --import tsx scripts/seed.ts",
    "test:browser": "node scripts/browser-e2e.cjs",
    "test:browser:readonly": "node scripts/browser-readonly.cjs",
    "test:rpc": "node node_modules/vitest/vitest.mjs run tests/rpcProxy.test.ts",
    "preview:rpc": "node scripts/worker-preview.mjs",
    "test:i18n": "node node_modules/vitest/vitest.mjs run tests/i18n.test.tsx",
    "test:i18n:browser": "node scripts/browser-i18n.cjs",
    "chain:i18n": "node --import tsx scripts/i18n-local.ts",
    "test:all": "node node_modules/vitest/vitest.mjs run",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "test:worker": "node --import tsx scripts/check-worker.ts",
    "index:checkpoint": "node --import tsx scripts/leaderboard-checkpoint.ts",
    "test:profile:browser": "node --import tsx scripts/profile-name-browser.ts",
    "index:rebuild": "node --import tsx scripts/rebuild-leaderboard.ts",
    "build:workers:testnet": "node node_modules/typescript/bin/tsc --noEmit && node scripts/build-workers.mjs testnet",
    "workers:check:testnet": "node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.testnet.jsonc --dry-run --outdir .wrangler/dry-run-testnet"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "solc": "0.8.30",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  }
}

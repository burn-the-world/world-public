{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-bsc-mainnet",
  "compatibility_date": "2026-09-29",
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/rpc",
      "/api/*"
    ]
  },
  "main": "worker/index.ts",
  "vars": {
    "WORLD_NETWORK": "mainnet",
    "MAINNET_ENABLED": "true"
  },
  "alias": {
    "@world-network": "./config/networks/mainnet.json"
  }
}
